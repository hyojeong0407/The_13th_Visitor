{
  "name": "the-13th-visitor",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "description": "13번째 방문자 (The 13th Visitor) - 16비트 레트로 한국 오컬트 추리 RPG",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint js version.js tests",
