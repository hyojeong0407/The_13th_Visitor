    "format:check": "prettier --check \"js/**/*.js\" \"tests/**/*.js\" version.js"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  }
}
